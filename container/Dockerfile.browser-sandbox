# DuDuClaw Browser Sandbox — L4 Container
# Headless Playwright + Chromium with network isolation
#
# Usage:
#   docker build -f container/Dockerfile.browser-sandbox -t duduclaw/browser-sandbox .
#   docker run --read-only --tmpfs /tmp:size=256m --network=none duduclaw/browser-sandbox
#
# Nothing in the repository starts this image. It works with
# `--network=none` only: the ENTRYPOINT is domain-filter.sh, which needs root
# and CAP_NET_ADMIN to install its egress filter, but this image runs as
# `USER sandbox`. With any network attached the filter cannot be installed
# and the script refuses to start (fail closed); it never runs unfiltered.
# A networked run would need the filter installed as root with NET_ADMIN
# before dropping to the unprivileged user (as Dockerfile.computer-use's
# entrypoint does), which this Dockerfile does not do.

FROM mcr.microsoft.com/playwright:v1.52.0-noble

# Install domain-level network filtering
RUN apt-get update && apt-get install -y --no-install-recommends \
    iptables \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r sandbox && useradd -r -g sandbox -m sandbox

# Copy domain filter script
COPY container/scripts/domain-filter.sh /usr/local/bin/domain-filter.sh
RUN chmod +x /usr/local/bin/domain-filter.sh

# Working directories
RUN mkdir -p /agent /workspace /screenshots && \
    chown sandbox:sandbox /workspace /screenshots

USER sandbox
WORKDIR /workspace

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD node -e "console.log('ok')" || exit 1

ENTRYPOINT ["/usr/local/bin/domain-filter.sh"]
CMD ["npx", "playwright", "test", "--reporter=json"]
