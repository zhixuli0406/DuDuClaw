{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the DuDuClaw desktop shell (TODO §D).",
  "windows": [
    "main",
    "mascot"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/duduclaw",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "updater:default",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-open-main-window",
    "allow-open-external-url",
    "allow-pet-list",
    "allow-pet-generate",
    "allow-pet-active-get",
    "allow-pet-activate",
    "allow-pet-remove",
    "allow-pet-load-active",
    "allow-pet-model-status",
    "allow-pet-model-download",
    "allow-pet-context-menu",
    "allow-pet-set-scale",
    "allow-pet-get-scale",
    "allow-pet-open-studio",
    "allow-gateway-discover",
    "allow-gateway-health",
    "allow-gateway-select",
    "allow-gateway-last",
    "allow-gateway-local-status",
    "allow-gateway-start-local",
    "allow-gateway-open-picker",
    "allow-desktop-update-status",
    "allow-desktop-restart-and-update"
  ]
}
