{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-gateway",
  "description": "The main/mascot webviews navigate to the dashboard served by the selected gateway (a remote origin from Tauri's point of view — loopback sidecar or an enterprise LAN gateway chosen via the picker). Without remote coverage every app command invoke is denied by the ACL (e.g. pet_generate). Scope: no shell permissions here — remote pages get core plumbing + app commands only.",
  "windows": [
    "main",
    "mascot"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://*:*",
      "https://*:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "notification:default",
    "allow-open-main-window",
    "allow-pet-list",
    "allow-pet-generate",
    "allow-pet-active-get",
    "allow-pet-activate",
    "allow-pet-remove",
    "allow-pet-load-active",
    "allow-pet-model-status",
    "allow-pet-model-download",
    "allow-pet-context-menu",
    "allow-pet-set-scale",
    "allow-pet-get-scale",
    "allow-pet-open-studio",
    "allow-gateway-discover",
    "allow-gateway-health",
    "allow-gateway-select",
    "allow-gateway-last",
    "allow-gateway-local-status",
    "allow-gateway-start-local",
    "allow-gateway-open-picker"
  ]
}
