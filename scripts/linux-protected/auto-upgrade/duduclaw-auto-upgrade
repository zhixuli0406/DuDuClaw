#!/bin/sh
set -eu
# The frozen root-owned launcher discovers a candidate as duduclaw-dl and asks
# the update service to verify it. This helper never downloads or installs code.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL
UPDATER=/usr/libexec/duduclaw-updated-launch
[ "$(id -u)" = 0 ] || { echo 'duduclaw-auto-upgrade: must run as root' >&2; exit 1; }
case "$#:$*" in
    0:) exec "$UPDATER" --check-latest ;;
    1:--dry-run) exec "$UPDATER" --check-latest --dry-run ;;
    *) echo 'usage: duduclaw-auto-upgrade [--dry-run]' >&2; exit 1 ;;
esac
