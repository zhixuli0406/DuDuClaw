[Unit]
Description=Verify and activate signed protected DuDuClaw updates
After=network-online.target
Wants=network-online.target
# R6: only spawnd's start, whose READY=1 means its root update endpoint is
# bound (also on an inconsistent set, so this service can repair the host).
# Not ordered after gateway or egress: their readback sockets are read with
# timeouts and retries during an activation. Wants=, not Requires=: this
# service restarts spawnd itself during an activation, and Requires= would
# propagate that restart to this service.
Wants=duduclaw-spawnd.service
After=duduclaw-spawnd.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Slice=duduclaw-tcb.slice
Type=simple
# No User=/Group= (R7g): root is the default. An explicit User=root together
# with NoNewPrivileges= and a seccomp-based directive makes systemd 255 drop
# CAP_SETUID, which the downloader needs to drop its child to duduclaw-dl.
ExecStart=/usr/libexec/duduclaw-updated-launch --launch
Restart=on-failure
RestartSec=2
RuntimeDirectory=duduclaw-updated
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/duduclaw-updated /etc/duduclaw-updated /opt/duduclaw-isolated
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# No RestrictSUIDSGID= (R7g): under it systemd's seccomp filter answers ENOSYS
# for every openat2, and the updater reads and writes its signed manifests,
# state and receipts through openat2 with RESOLVE_* guarantees. Still holds: a
# root service that creates no set-ID files; NoNewPrivileges=yes stays.
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Read loaded non-dumpable executables and connect private service-owned health sockets.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_SYS_PTRACE CAP_DAC_OVERRIDE
LimitCORE=0
LimitNOFILE=256
TasksMax=16
MemoryMax=256M
CPUQuota=100%
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
