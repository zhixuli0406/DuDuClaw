      "name": "svg_data_image"
    },
    {
      "expected": "<img>",
      "input": "<img src=\"data:image/png;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxzY3JpcHQ+YWxlcnQoMSk8L3NjcmlwdD48L3N2Zz4=\">",
      "name": "png_declared_svg_bytes"
    },
    {
      "expected": "<img>",
      "input": "<img src=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">",
      "name": "data_html_image"
    },
    {
      "expected": "<img>",
      "input": "<img src=\"https://example.com/a.png\">",
      "name": "remote_image"
    },
    {
      "expected": "<img>",
      "input": "<img src=\"x\" onerror=\"alert(1)\">",
      "name": "img_event_handler"
    },
    {
      "expected": "<p>ok</p>",
      "input": "<iframe src=\"https://example.com\"></iframe><object data=\"x\"></object><form action=\"https://example.com\"><input name=\"q\"></form><p>ok</p>",
      "name": "embedding_elements"
    },
    {
      "expected": "<p>ok</p>",
      "input": "<style>body{display:none}</style><p>ok</p>",
      "name": "style_element"
    },
    {
      "expected": "<p>ok</p>",
      "input": "<svg><script>alert(1)</script><circle r=\"5\"></circle></svg><p>ok</p>",
      "name": "svg_script"
    },
    {
      "expected": "<p>ok</p>",
      "input": "<!-- internal note --><p>ok</p>",
      "name": "comment"
    },
    {
      "expected": "<table><thead><tr><th>Region</th></tr></thead><tbody><tr><td>North</td></tr></tbody></table>",
      "input": "<table><thead><tr><th>Region</th></tr></thead><tbody><tr><td>North</td></tr></tbody></table>",
      "name": "table"
    },
    {
      "expected": "<ul><li>a</li></ul><ol><li>b</li></ol><blockquote>q</blockquote><pre><code>x &lt; y</code></pre><hr>",
      "input": "<ul><li>a</li></ul><ol><li>b</li></ol><blockquote>q</blockquote><pre><code>x &lt; y</code></pre><hr>",
      "name": "lists_and_code"
    },
    {
      "expected": null,
      "input": "<script>alert(1)</script>",
      "name": "only_script_is_empty"
    },
    {
      "expected": null,
      "input": "   \n  ",
      "name": "whitespace_only_is_empty"
    }
  ]
