[Unit]
Description=DuDuClaw disposable parse worker

[Service]
Type=exec
ExecStart=/usr/libexec/duduclaw/duduclaw-parse-worker
DynamicUser=yes
StandardInput=socket
StandardOutput=null
StandardError=null
PrivateNetwork=yes
IPAddressDeny=any
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
# Fixed list for dynamic loading and service setup. The executable installs a
# smaller BPF allowlist before parsing (no opens, exec, clone, socket or connect).
SystemCallFilter=read write close ftruncate pread64 readv writev lseek fstat newfstatat statx openat access faccessat readlink readlinkat mmap mprotect munmap mremap brk madvise futex clock_gettime clock_nanosleep nanosleep rt_sigaction rt_sigprocmask rt_sigreturn sigaltstack getrandom getpid gettid getuid geteuid getgid getegid getresuid getresgid sched_yield restart_syscall sendmsg recvmsg ppoll poll exit exit_group execve arch_prctl set_tid_address set_robust_list rseq prlimit64 setrlimit getrlimit prctl seccomp fcntl fstatfs getsockopt pidfd_open close_range alarm setitimer
SystemCallErrorNumber=EPERM
# v249 gives ProtectSystem's READONLY / priority over TMPFS /. RootDirectory
# is the staging mountpoint; the separate skeleton hides the base directories
# systemd creates there. /var is recreated for /var/tmp. Both roots are root:root 0755.
RootDirectory=/usr/lib/duduclaw/parse-root
# ProtectProc/ProcSubset and kernel protections still require private API VFS.
# Explicit no suppresses v255's automatic host os-release projection into /run.
MountAPIVFS=no
BindReadOnlyPaths=/usr/lib/duduclaw/parse-root-tree:/:norbind
# The signed installer populates parse-root-tree with only the verified worker,
# its ELF interpreter, and the exact dependency closure. Never bind host /usr,
# /lib or /lib64 here: those expose unrelated programs and application data.
# DynamicUser forces PrivateTmp. Higher-priority binds at both /tmp and
# /var/tmp replace its host-disk directories with the same bounded tmpfs.
# Mounts sort by destination: /.tmp exists before the bind sources are resolved
# through the staging path, before systemd pivots into the new root.
# Kernel protections force a read-only /sys projection; hide module aliases.
InaccessiblePaths=-/usr/local -/usr/lib/duduclaw -/lib/modules -/lib64/modules
TemporaryFileSystem=/.tmp:rw,nosuid,nodev,noexec,size=8M,nr_inodes=1024,mode=0700
BindPaths=/usr/lib/duduclaw/parse-root/.tmp:/tmp:norbind
BindPaths=/usr/lib/duduclaw/parse-root/.tmp:/var/tmp:norbind
TemporaryFileSystem=/run:ro
TemporaryFileSystem=/dev/shm:ro
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=1
LimitNOFILE=64
LimitCORE=0
LimitFSIZE=64M
RuntimeMaxSec=35
TimeoutStartSec=5
TimeoutStopSec=1
KillMode=control-group
SendSIGKILL=yes
UMask=0077
