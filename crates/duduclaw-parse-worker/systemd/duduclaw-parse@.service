[Unit]
Description=DuDuClaw disposable parse worker

[Service]
Type=exec
ExecStart=/usr/libexec/duduclaw/duduclaw-parse-worker
DynamicUser=yes
StandardInput=socket
StandardOutput=null
StandardError=null
PrivateNetwork=yes
IPAddressDeny=any
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
# Fixed list for dynamic loading and service setup. The executable installs a
# smaller BPF allowlist before parsing (no opens, exec, clone, socket or connect).
SystemCallFilter=read write close ftruncate pread64 readv writev lseek fstat newfstatat statx openat access faccessat readlink readlinkat mmap mprotect munmap mremap brk madvise futex clock_gettime clock_nanosleep nanosleep rt_sigaction rt_sigprocmask rt_sigreturn sigaltstack getrandom getpid gettid getuid geteuid getgid getegid getresuid getresgid sched_yield restart_syscall sendmsg recvmsg ppoll poll exit exit_group execve arch_prctl set_tid_address set_robust_list rseq prlimit64 setrlimit getrlimit prctl seccomp fcntl fstatfs getsockopt close_range alarm setitimer
SystemCallErrorNumber=EPERM
# Hide all persistent application state and host IPC endpoints. Only runtime
# libraries and the fixed executable are projected into the otherwise empty root.
TemporaryFileSystem=/:ro
BindReadOnlyPaths=/usr
BindReadOnlyPaths=-/lib -/lib64
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=8M,nr_inodes=1024,mode=0700
TemporaryFileSystem=/run:ro
TemporaryFileSystem=/dev/shm:ro
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=1
LimitNOFILE=64
LimitCORE=0
LimitFSIZE=64M
RuntimeMaxSec=35
TimeoutStartSec=5
TimeoutStopSec=1
KillMode=control-group
SendSIGKILL=yes
UMask=0077
