{
  "name": "duduclaw-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "DuDuClaw plugin for Obsidian",
  "scripts": {
    "check": "tsc --noEmit -p ./",
    "build": "npm run check && esbuild src/main.ts --bundle --outfile=main.js --format=cjs --platform=browser --target=es2022 --external:obsidian"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "obsidian": "^1.5.7",
    "typescript": "^5.5.0"
  }
}
